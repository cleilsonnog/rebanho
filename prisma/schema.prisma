generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Cada igreja é um tenant. Será ligada à organização do Clerk por `clerkOrgId`.
model Church {
  id         String  @id @default(cuid())
  clerkOrgId String? @unique
  nome       String
  sigla      String  @default("")
  cnpj       String  @default("")
  pastor     String  @default("")
  telefone   String  @default("")
  email      String  @default("")
  rua        String  @default("")
  numero     String  @default("")
  bairro     String  @default("")
  cidade     String  @default("")
  uf         String  @default("") @db.Char(2)
  cep        String  @default("")
  /// Posição da igreja no mapa (centro dos mapas do painel), calculada pelo endereço.
  lat        Float?
  lng        Float?
  /// Logo guardada no Clerk (organização); aqui fica só o endereço da imagem.
  logoUrl    String?

  whatsappConectado  Boolean @default(false)
  whatsappNumero     String?
  whatsappDiasAntes  Int     @default(1)
  whatsappAutomatico Boolean @default(true)
  whatsappMensagem   String  @default("Olá, {nome}! 🎉 A {igreja} celebra a sua vida hoje. Feliz aniversário!")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users         ChurchUser[]
  congregations Congregation[]
  members       Member[]
  visits        Visit[]
  transactions  Transaction[]
  events        Event[]
  certificates  Certificate[]
  cells         Cell[]
  cellMeetings  CellMeeting[]
  cellStudies   CellStudy[]
  auditLogs     AuditLog[]
}

enum UserRole {
  admin
  secretaria
  tesouraria
  pastor
  lider
}

/// Usuário do sistema dentro de uma igreja. O login é do Clerk; a função (papel) fica aqui,
/// porque papéis customizados do Clerk são pagos em produção.
model ChurchUser {
  id                String        @id @default(cuid())
  churchId          String
  church            Church        @relation(fields: [churchId], references: [id], onDelete: Cascade)
  /// Preenchido no primeiro acesso; antes disso o convite está pendente.
  clerkUserId       String?
  clerkInvitationId String?
  nome              String
  email             String
  papel             UserRole      @default(lider)
  ativo             Boolean       @default(true)
  /// Cadastro de membro desta pessoa. Para o líder de célula, diz quais células ele lidera.
  memberId          String?       @unique
  member            Member?       @relation(fields: [memberId], references: [id], onDelete: SetNull)
  /// Secretaria ou pastor de uma filial: só vê e altera os dados dela. Vazio = igreja toda.
  /// Restrict: apagar a filial não pode, sem querer, liberar a igreja toda para esse usuário.
  congregationId    String?
  congregation      Congregation? @relation(fields: [congregationId], references: [id], onDelete: Restrict)
  createdAt         DateTime      @default(now())

  @@unique([churchId, email])
  @@unique([churchId, clerkUserId])
}

/// Sede ou filial da igreja. A primeira (mais antiga) é a sede e usa o endereço da igreja.
model Congregation {
  id        String       @id @default(cuid())
  churchId  String
  church    Church       @relation(fields: [churchId], references: [id], onDelete: Cascade)
  nome      String
  dirigente String       @default("")
  telefone  String       @default("")
  rua       String       @default("")
  numero    String       @default("")
  bairro    String       @default("")
  cidade    String       @default("")
  uf        String       @default("") @db.Char(2)
  cep       String       @default("")
  lat       Float?
  lng       Float?
  members   Member[]
  cells     Cell[]
  users     ChurchUser[]

  @@unique([churchId, nome])
}

enum MemberStatus {
  ativo
  afastado
  visitante
  transferido
}

enum Sexo {
  M
  F
}

enum EstadoCivil {
  solteiro
  casado
  divorciado
  viuvo
}

model Member {
  id             String        @id @default(cuid())
  churchId       String
  church         Church        @relation(fields: [churchId], references: [id], onDelete: Cascade)
  congregationId String?
  congregation   Congregation? @relation(fields: [congregationId], references: [id], onDelete: SetNull)
  /// Célula que a pessoa frequenta (uma por pessoa).
  cellId         String?
  cell           Cell?         @relation(fields: [cellId], references: [id], onDelete: SetNull)

  nome        String
  sexo        Sexo
  nascimento  DateTime     @db.Date
  telefone    String       @default("")
  email       String       @default("")
  estadoCivil EstadoCivil  @default(solteiro)
  rua         String       @default("")
  numero      String       @default("")
  bairro      String       @default("")
  cidade      String       @default("")
  uf          String       @default("") @db.Char(2)
  cep         String       @default("")
  lat         Float?
  lng         Float?
  cargo       String       @default("Membro")
  ministerios String[]
  status      MemberStatus @default(ativo)
  batizado    Boolean      @default(false)
  dataBatismo DateTime?    @db.Date
  membroDesde DateTime     @db.Date
  observacoes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  visits       Visit[]
  transactions Transaction[]
  certificates Certificate[]
  cellRoles    CellLeader[]
  attendances  CellAttendance[]
  churchUser   ChurchUser?

  @@index([churchId, nome])
  @@index([churchId, status])
}

model Visit {
  id            String    @id @default(cuid())
  churchId      String
  church        Church    @relation(fields: [churchId], references: [id], onDelete: Cascade)
  memberId      String
  member        Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  data          DateTime  @db.Date
  responsavel   String
  motivo        String
  notas         String
  proximaVisita DateTime? @db.Date
  createdAt     DateTime  @default(now())

  @@index([churchId, data])
}

enum TransactionType {
  entrada
  saida
}

enum PaymentMethod {
  pix
  dinheiro
  cartao
  transferencia
  boleto
}

model Transaction {
  id             String          @id @default(cuid())
  churchId       String
  church         Church          @relation(fields: [churchId], references: [id], onDelete: Cascade)
  memberId       String?
  member         Member?         @relation(fields: [memberId], references: [id], onDelete: SetNull)
  tipo           TransactionType
  categoria      String
  valor          Decimal         @db.Decimal(12, 2)
  data           DateTime        @db.Date
  descricao      String
  formaPagamento PaymentMethod
  createdAt      DateTime        @default(now())

  @@index([churchId, data])
}

enum EventType {
  culto
  reuniao
  evento
  ensaio
  curso
}

model Event {
  id        String    @id @default(cuid())
  churchId  String
  church    Church    @relation(fields: [churchId], references: [id], onDelete: Cascade)
  titulo    String
  data      DateTime  @db.Date
  hora      String    @db.VarChar(5)
  local     String
  tipo      EventType
  descricao String?

  @@index([churchId, data])
}

enum CertificateStyle {
  classico
  moderno
  minimalista
}

model Certificate {
  id        String           @id @default(cuid())
  churchId  String
  church    Church           @relation(fields: [churchId], references: [id], onDelete: Cascade)
  memberId  String
  member    Member           @relation(fields: [memberId], references: [id], onDelete: Cascade)
  tipo      String
  estilo    CertificateStyle
  detalhe   String           @default("")
  emitidoEm DateTime         @db.Date

  @@index([churchId, emitidoEm])
}

/// Célula (pequeno grupo que se reúne numa casa). O pino no mapa é a casa do anfitrião.
model Cell {
  id        String   @id @default(cuid())
  churchId  String
  church    Church   @relation(fields: [churchId], references: [id], onDelete: Cascade)
  nome      String
  /// 0 = domingo … 6 = sábado
  diaSemana Int?
  horario   String   @default("") @db.VarChar(5)
  rua       String   @default("")
  numero    String   @default("")
  bairro    String   @default("")
  cidade    String   @default("")
  uf        String   @default("") @db.Char(2)
  cep       String   @default("")
  lat       Float?
  lng       Float?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  leaders        CellLeader[]
  members        Member[]
  meetings       CellMeeting[]
  /// Filial a que a célula pertence (vazio = sede).
  congregationId String?
  congregation   Congregation? @relation(fields: [congregationId], references: [id], onDelete: SetNull)

  @@unique([churchId, nome])
}

enum CellRole {
  lider
  colider
  anfitriao
}

/// Liderança da célula: até duas pessoas (um casal) por função. A mesma pessoa pode ser líder e anfitriã.
model CellLeader {
  cellId   String
  cell     Cell     @relation(fields: [cellId], references: [id], onDelete: Cascade)
  memberId String
  member   Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  funcao   CellRole

  @@id([cellId, memberId, funcao])
}

/// Reunião de um dia: presença dos membros, visitantes e observações. Uma por célula por dia.
model CellMeeting {
  id          String           @id @default(cuid())
  churchId    String
  church      Church           @relation(fields: [churchId], references: [id], onDelete: Cascade)
  cellId      String
  cell        Cell             @relation(fields: [cellId], references: [id], onDelete: Cascade)
  data        DateTime         @db.Date
  observacoes String           @default("")
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  presencas   CellAttendance[]
  visitantes  CellVisitor[]

  @@unique([cellId, data])
  @@index([churchId, data])
}

model CellAttendance {
  meetingId String
  meeting   CellMeeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  memberId  String
  member    Member      @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@id([meetingId, memberId])
}

/// Visitante de uma reunião, ainda sem cadastro de membro.
model CellVisitor {
  id        String      @id @default(cuid())
  meetingId String
  meeting   CellMeeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  nome      String
  telefone  String      @default("")
}

/// Estudo da semana, publicado pelo pastor ou pela secretaria para todas as células.
model CellStudy {
  id         String   @id @default(cuid())
  churchId   String
  church     Church   @relation(fields: [churchId], references: [id], onDelete: Cascade)
  /// Segunda-feira da semana do estudo.
  semana     DateTime @db.Date
  tema       String
  referencia String   @default("")
  texto      String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([churchId, semana])
}

/// Histórico de alterações (quem mudou o quê e quando), gravado por `secureAction` só quando a ação dá certo.
/// Quem fez fica copiado (nome e função): o registro continua legível se o usuário for removido.
/// Não é apagado com os dados da igreja ("Apagar dados"); só depois de 12 meses (lib/audit.ts).
model AuditLog {
  id        String   @id @default(cuid())
  churchId  String
  church    Church   @relation(fields: [churchId], references: [id], onDelete: Cascade)
  userId    String?
  userNome  String
  papel     UserRole
  /// Área da permissão (lib/permissions.ts); vazio = ação só do admin.
  area      String?
  descricao String
  createdAt DateTime @default(now())

  @@index([churchId, createdAt])
}

/// Centro aproximado de cada bairro, já consultado no OpenStreetMap. Dado público, compartilhado
/// entre igrejas, para não repetir consultas (o Nominatim pede no máximo 1 por segundo).
model GeoBairro {
  /// "bairro|cidade|uf" em minúsculas e sem acento
  chave     String   @id
  lat       Float?
  lng       Float?
  createdAt DateTime @default(now())
}

/// Contador do rate limit: quantas vezes `key` agiu na janela que começa em `windowStart`.
model RateLimit {
  key         String
  windowStart DateTime
  count       Int      @default(1)

  @@id([key, windowStart])
  @@index([windowStart])
}
