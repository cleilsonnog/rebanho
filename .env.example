# Neon (Postgres). DATABASE_URL = conexão pooled (app); DIRECT_URL = conexão direta (migrations).
DATABASE_URL=
DIRECT_URL=

# Clerk (dashboard.clerk.com → API Keys). Ative Organizations com "Membership required".
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Rotas do Clerk
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/entrar
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/criar-conta
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/app
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/app

# URL pública do app (usada no link dos convites quando não há cabeçalho Origin)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Backup semanal (lib/backup.ts, docs/backup.md). Neon: Settings do projeto → Project ID;
# Account/Organization settings → API keys (prefira uma chave só deste projeto).
NEON_API_KEY=
NEON_PROJECT_ID=
# Segredo que a Vercel Cron manda para /api/cron/backup. Gere com: openssl rand -hex 32
CRON_SECRET=

# Testes automáticos (npm test): banco da branch "testes" da Neon, nunca o de produção. tests/README.md
TEST_DATABASE_URL=
TEST_DIRECT_URL=
